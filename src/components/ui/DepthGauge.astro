---
/**
 * Depth Gauge: fixed vertical list of the page's layers (PLAN §2.4). Tier = tick length,
 * current layer highlighted via IntersectionObserver, links are plain anchors (Lenis smooths them), arrow keys move focus.
 * Numbers hidden below 900px; titles on hover/focus.
 */
import { getLangFromUrl, useT } from '../../i18n';
interface Props {
  layers: { id: string; title: string; tier: string }[];
}
const { layers } = Astro.props;
const t = useT(getLangFromUrl(Astro.url));
---

<nav class="gauge" aria-label={t('gauge.label')} data-gauge>
  <ol class="gauge__list">
    {
      layers.map((l, i) => (
        <li>
          <a class="gauge__link" href={`#${l.id}`} data-gauge-link={l.id} style={`--tier:${Number(l.tier.slice(1)) || 0}`} aria-label={t('gauge.jump', { layer: l.title })}>
            <span class="gauge__text">
              <span class="gauge__title">{l.title}</span>
              <span class="gauge__tier">{t(`tier.${l.tier}`)}</span>
            </span>
            <span class="gauge__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="gauge__tick" aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  const gauge = document.querySelector<HTMLElement>('[data-gauge]');
  if (gauge) {
    const links = [...gauge.querySelectorAll<HTMLAnchorElement>('[data-gauge-link]')];
    const byId = new Map(links.map((a) => [a.dataset.gaugeLink!, a]));
    const setCurrent = (id: string) => {
      links.forEach((a) => {
        if (a.dataset.gaugeLink === id) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    };
    const sections = [...document.querySelectorAll<HTMLElement>('section[data-layer]')].filter((s) => byId.has(s.id));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) setCurrent(e.target.id);
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
    if (sections[0]) setCurrent(sections[0].id);
    gauge.addEventListener('keydown', (e) => {
      const i = links.indexOf(document.activeElement as HTMLAnchorElement);
      if (i < 0) return;
      const next = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? i - 1 : null;
      if (next === null) return;
      e.preventDefault();
      links[(next + links.length) % links.length].focus();
    });
  }
</script>

<style>
  .gauge {
    position: fixed;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    z-index: var(--z-gauge);
    padding: var(--space-2) var(--space-2) var(--space-2) 0;
  }
  .gauge__list {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .gauge__list::before {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }
  .gauge__link {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-2);
    height: 1.6rem;
    text-decoration: none;
    color: var(--fg-faint);
    position: relative;
  }
  .gauge__num {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
  }
  /* Tick length encodes the tier (T0 short .. T4 long). */
  .gauge__tick {
    width: calc(0.4rem + var(--tier) * 0.15rem);
    height: 1px;
    background: var(--fg-faint);
    flex: none;
  }
  .gauge__text {
    display: none;
    position: absolute;
    right: calc(100% + var(--space-2));
    top: 50%;
    translate: 0 -50%;
    width: max-content;
    max-width: 14rem;
    text-align: right;
    font-size: var(--fs-sm);
    line-height: 1.25;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
    box-shadow: 0 2px 8px var(--shadow);
  }
  .gauge__tier {
    display: block;
    font-size: var(--fs-xs);
    color: var(--fg-muted);
  }
  .gauge__link:hover,
  .gauge__link:focus-visible {
    color: var(--fg);
  }
  .gauge__link:hover .gauge__text,
  .gauge__link:focus-visible .gauge__text {
    display: block;
  }
  .gauge__link[aria-current] {
    color: var(--accent);
  }
  .gauge__link[aria-current] .gauge__tick {
    background: var(--accent);
    height: 2px;
  }
  @media (max-width: 899px) {
    .gauge {
      padding-right: 0;
    }
    .gauge__num {
      display: none;
    }
    .gauge__link {
      height: 1.3rem;
    }
  }
</style>
