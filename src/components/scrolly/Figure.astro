---
/** <Figure kind caption> — figure wrapper with a numbered caption below. Optional `scene`/`state` renders an inline scene; otherwise wraps the slot (e.g. an image). */
import Scene from './Scene.astro';
import { getLangFromUrl, useT } from '../../i18n';
interface Props {
  kind?: 'schematic' | 'simulated';
  caption?: string;
  scene?: string;
  state?: string;
}
const { kind, caption, scene, state } = Astro.props;
const t = useT(getLangFromUrl(Astro.url));
---

<figure class="fig">
  <div class="fig__frame">
    {scene && <Scene id={scene} state={state} label={caption} />}
    <slot />
  </div>
  {
    (caption || kind) && (
      <figcaption class="fig__caption">
        <span class="fig__num">{t('scrolly.figure.label')} </span>
        {caption}
        {kind && <em class="fig__kind"> {t(`scrolly.figure.${kind}`)}</em>}
      </figcaption>
    )
  }
</figure>

<style is:global>
  .fig {
    margin: var(--space-8) auto;
    max-width: var(--col-wide);
    counter-increment: fig;
  }
  .fig__frame .scene {
    margin: 0;
  }
  .fig__num {
    font-weight: 600;
  }
  .fig__num::after {
    content: counter(fig) '.';
    margin-right: 0.3em;
  }
  .fig__caption {
    color: var(--fg-muted);
    font-size: var(--fs-sm);
    line-height: 1.5;
    margin-top: var(--space-2);
    max-width: var(--measure);
  }
  .fig__kind {
    font-style: italic;
  }
</style>
