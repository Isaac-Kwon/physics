---
import { relatedTopics } from '../../lib/connections';
import { TOPICS, accentCss, type TopicId } from '../../data/topics';
import { getLangFromUrl, localizePath, useT } from '../../i18n';

interface Props {
  topic: TopicId;
}
const lang = getLangFromUrl(Astro.url);
const t = useT(lang);
const items = relatedTopics(Astro.props.topic).map((r) => ({
  ...r,
  def: TOPICS[r.topic],
  href: r.link.live ? localizePath(lang, `/${r.link.to.topic}/#${r.link.to.layer}`) : undefined,
}));
---

{
  items.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <h2 id="related-title">{t('related.title')}</h2>
      <ul>
        {items.map((r) => {
          const Tag = r.href ? 'a' : 'div';
          return (
            <li>
              <Tag class:list={['card', { soon: !r.href }]} href={r.href} style={`--card-accent:${accentCss(r.def.id)}`}>
                <span class="card__title">{t(`topic.${r.topic}.title`)}</span>
                <span class="card__reason">{r.link.reason[lang]}</span>
                {!r.href && <span class="card__soon">{t('card.comingSoon')}</span>}
              </Tag>
            </li>
          );
        })}
      </ul>
    </section>
  )
}

<style>
  .related {
    max-width: 60rem;
    margin: var(--space-16) auto var(--space-8);
    padding: 0 var(--space-4);
  }
  h2 {
    font-size: var(--fs-lg);
    margin: 0 0 var(--space-4);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    box-sizing: border-box;
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-top: 3px solid var(--card-accent);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--fg);
    text-decoration: none;
    transition: background var(--dur-fast);
  }
  a.card:hover,
  a.card:focus-visible {
    background: color-mix(in oklab, var(--card-accent) 8%, var(--bg-raised));
  }
  a.card:focus-visible {
    outline: 2px solid var(--card-accent);
    outline-offset: 2px;
  }
  .card__title {
    font-weight: 600;
  }
  .card__reason {
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }
  .card__soon {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--fg-faint);
  }
  .soon {
    border-style: dashed;
    opacity: 0.75;
  }
</style>
