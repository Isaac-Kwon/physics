---
/**
 * Scene gallery (dev, noindex): /<lang>/lab/scenes/<scene-id>/ renders every state of one scene, stacked, each inline.
 * Used by scene builders and reviewers to screenshot all states at once. Scene modules are imported at build time to
 * read `states`, so they must not touch window/document at module top level.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Scene from '../../../../components/scrolly/Scene.astro';
import { LANGS, TOPICS, type Lang, type TopicId } from '../../../../data/topics';
import { scenes, SCENE_DIR_PREFIX } from '../../../../scenes/registry';

export async function getStaticPaths() {
  const out = [];
  for (const id of Object.keys(scenes)) {
    let states: string[] = [];
    let error = '';
    try {
      states = [...(await scenes[id]()).default.states];
    } catch (e) {
      error = String(e);
    }
    for (const lang of LANGS) out.push({ params: { lang, id }, props: { states, error } });
  }
  return out;
}

const lang = Astro.params.lang as Lang;
const id = Astro.params.id as string;
const { states, error } = Astro.props as { states: string[]; error: string };
const prefix = id.split('.')[0];
const dir = Object.entries(SCENE_DIR_PREFIX).find(([, p]) => p === prefix)?.[0];
const topic = dir && dir in TOPICS ? (dir as TopicId) : undefined;
---

<BaseLayout lang={lang} title={`Scene ${id}`} topic={topic}>
  <meta slot="head" name="robots" content="noindex" />
  <div class="gallery">
    <h1 class="mono">{id}</h1>
    {error && <pre class="err">{error}</pre>}
    {
      states.map((s, i) => (
        <section class="state" data-state-name={s}>
          <p class="label mono">
            {i + 1}/{states.length} · {s}
          </p>
          <Scene id={id} state={s} />
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .gallery {
    max-width: var(--col-wide);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-24);
  }
  h1 {
    font-size: var(--fs-lg);
  }
  .state {
    margin-block: var(--space-8);
  }
  .err {
    color: #c0392b;
    white-space: pre-wrap;
  }
</style>
