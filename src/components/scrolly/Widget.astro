---
/** <Widget name ...props> — P5. Svelte widget src/components/widgets/<name>.svelte is mounted lazily on the client (see src/lib/scroll.ts). */
import { getLangFromUrl, useT } from '../../i18n';
interface Props {
  name: string;
  [prop: string]: unknown;
}
const { name, ...props } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useT(lang);
const exists = Object.keys(import.meta.glob('../widgets/*.svelte')).some((p) => p.endsWith(`/${name}.svelte`));
---

<div class="widget" data-widget={name} data-lang={lang} data-props={JSON.stringify(props)} data-missing={exists ? undefined : ''}>
  <p class="widget__status">{exists ? t('scrolly.widget.loading') : t('scrolly.widget.missing', { name })}</p>
</div>

<style is:global>
  .widget {
    max-width: var(--col-wide);
    margin: var(--space-8) auto;
    padding: var(--space-4) 0;
    border-block: 1px solid var(--line);
  }
  .widget[data-missing] {
    color: var(--fg-faint);
  }
  .widget__status {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }
</style>
