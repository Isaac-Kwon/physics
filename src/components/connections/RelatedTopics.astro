---
import { relatedTopics } from '../../lib/connections';
import { TOPICS, type TopicId } from '../../data/topics';
import { getLangFromUrl, localizePath, useT } from '../../i18n';

interface Props {
  topic: TopicId;
}
const lang = getLangFromUrl(Astro.url);
const t = useT(lang);
const items = relatedTopics(Astro.props.topic).map((r) => ({
  ...r,
  def: TOPICS[r.topic],
  href: r.link.live ? localizePath(lang, `/${r.link.to.topic}/#${r.link.to.layer}`) : undefined,
}));
---

{
  items.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <h2 id="related-title">{t('related.title')}</h2>
      <ul>
        {items.map((r) => {
          const Tag = r.href ? 'a' : 'div';
          return (
            <li>
              <Tag class:list={['card', { soon: !r.href }]} href={r.href}>
                <span class="card__title">{t(`topic.${r.topic}.title`)}</span>
                <span class="card__reason">{r.link.reason[lang]}</span>
                {!r.href && <em class="card__soon">{t('card.comingSoon')}</em>}
              </Tag>
            </li>
          );
        })}
      </ul>
    </section>
  )
}

<style>
  .related {
    max-width: var(--measure);
    margin: var(--space-16) auto var(--space-8);
    padding: 0 var(--space-4);
  }
  h2 {
    font-size: var(--fs-lg);
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-3);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  li {
    border-bottom: 1px solid var(--line);
  }
  .card {
    display: block;
    padding: var(--space-3) 0;
    color: var(--fg);
    text-decoration: none;
  }
  .card__title {
    display: block;
    font-weight: 600;
  }
  a.card:hover .card__title,
  a.card:focus-visible .card__title {
    color: var(--accent);
  }
  a.card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .card__reason {
    display: block;
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }
  .card__soon {
    font-size: var(--fs-sm);
    color: var(--fg-faint);
  }
  .soon .card__title {
    color: var(--fg-muted);
  }
</style>
