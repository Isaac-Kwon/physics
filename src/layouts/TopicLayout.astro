---
/** Topic page shell: hero, Depth Gauge, content slot, then "after" slot (related topics, references). Also used by the lab page. */
import 'katex/dist/katex.min.css';
import BaseLayout from './BaseLayout.astro';
import DepthGauge from '../components/ui/DepthGauge.astro';
import StepNav from '../components/scrolly/StepNav.astro';
import Scene from '../components/scrolly/Scene.astro';
import { getEntry } from 'astro:content';
import { scenes } from '../scenes/registry';
import { TOPICS, type TopicId } from '../data/topics';
import { useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  topic?: TopicId;
  title: string;
  subtitle?: string;
  description?: string;
  layers: { id: string; title: string; tier: string }[];
  noindex?: boolean;
}
const { lang, topic, title, subtitle, description, layers, noindex = false } = Astro.props;
const t = useT(lang);
const heroScene = topic ? TOPICS[topic].heroScene : undefined;
const minutes = topic ? TOPICS[topic].readingMinutes : undefined;
const entry = topic ? await getEntry('topics', `${topic}/${lang}`) : undefined;
const meta = [minutes ? t('card.readingTime', { min: minutes }) : null, entry?.data.draft ? t('scrolly.hero.draft') : null].filter(Boolean).join(' · ');
---

<BaseLayout lang={lang} topic={topic} title={title} description={description}>
  {noindex && <meta slot="head" name="robots" content="noindex" />}
  <header class="hero">
    <h1>{title}</h1>
    {subtitle && <p class="hero__sub">{subtitle}</p>}
    {meta && <p class="hero__meta">{meta}</p>}
    {heroScene && heroScene in scenes && <Scene id={heroScene} />}
  </header>
  <DepthGauge layers={layers} />
  <StepNav />
  <article class="topic__content">
    <slot />
  </article>
  <div class="topic__after"><slot name="after" /></div>
  <script>
    import { initScrolly } from '../lib/scroll';
    initScrolly();
  </script>
</BaseLayout>

<style is:global>
  /* One text column for the whole page: hero, layer headings, prose and asides share the same left edge. */
  .hero {
    padding: var(--space-16) var(--space-4) var(--space-8);
  }
  .hero > h1,
  .hero > .hero__sub,
  .hero > .hero__meta {
    max-width: var(--measure);
    margin-inline: auto !important;
  }
  .hero h1 {
    font-size: var(--fs-2xl);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-3);
  }
  :lang(ko) .hero h1 {
    letter-spacing: 0;
  }
  .hero__sub {
    font-size: var(--fs-lg);
    color: var(--fg-muted);
    margin: 0 0 var(--space-3);
  }
  .hero__meta {
    font-size: var(--fs-sm);
    color: var(--fg-muted);
    margin: 0 0 var(--space-8);
  }
  /* The text column is centred; at >=1100px the side margins (~250px+) hold the floating Bridge notes and the
     Depth Gauge. No overflow:hidden here (Bridge floats out of the column). */
  .topic__content {
    padding-inline: var(--space-4);
    counter-reset: fig;
  }
  /* Keep the Depth Gauge strip (right edge) clear of wide figures. */
  @media (min-width: 900px) {
    .topic__content {
      padding-inline: calc(var(--gauge-w) + var(--space-8));
    }
  }
  .topic__after {
    padding: var(--space-8) var(--space-4) var(--space-16);
  }
  /* Lenis */
  html.lenis,
  html.lenis body {
    height: auto;
  }
  .lenis.lenis-smooth {
    scroll-behavior: auto !important;
  }
  .lenis.lenis-stopped {
    overflow: clip;
  }
  .scene--portal.is-static {
    min-height: 0;
  }
</style>
