---
import { useT, type Lang } from '../../i18n';
interface Props {
  lang: Lang;
}
const t = useT(Astro.props.lang);
---

<section class="hero" aria-labelledby="hero-title">
  <canvas aria-hidden="true" data-hero-canvas></canvas>
  <p class="visually-hidden">{t('chrome.hub.heroLabel')}</p>
  <div class="copy">
    <p class="label">{t('site.tagline')}</p>
    <h1 id="hero-title">{t('hub.hero.title')}</h1>
    <p class="sub">{t('hub.hero.subtitle')}</p>
  </div>
</section>

<script>
  // Lightweight Canvas2D scene: one glowing particle curving through the dark, leaving a fading trail.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    // --accent is a light-dark() expression; resolve it to a concrete colour via the canvas' computed style.
    const resolve = () => {
      canvas.style.color = 'var(--accent)';
      return getComputedStyle(canvas).color || '#087ea3';
    };
    let accent = resolve();
    new MutationObserver(() => {
      accent = resolve();
      if (reduce.matches) still();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    let w = 0;
    let h = 0;
    let raf = 0;
    let visible = true;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    // Track = a spiral arc (charged particle in a magnetic field), param u in [0,1].
    const pos = (u: number) => {
      const x = -0.05 * w + u * 1.1 * w;
      const y = h * 0.62 - Math.sin(u * Math.PI) * h * 0.28 + Math.sin(u * 18) * h * 0.012 * (1 - u * 0.6);
      return [x, y] as const;
    };

    const resize = () => {
      const r = canvas.getBoundingClientRect();
      w = r.width;
      h = r.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const drawTrail = (head: number, len: number) => {
      const N = 90;
      ctx.lineCap = 'round';
      for (let i = 0; i < N; i++) {
        const u0 = head - (len * (i + 1)) / N;
        const u1 = head - (len * i) / N;
        if (u1 < 0 || u0 > 1) continue;
        const [x0, y0] = pos(Math.max(0, u0));
        const [x1, y1] = pos(Math.min(1, u1));
        const a = 1 - i / N;
        ctx.strokeStyle = accent;
        ctx.globalAlpha = a * a * 0.9;
        ctx.lineWidth = 0.6 + a * 2;
        ctx.beginPath();
        ctx.moveTo(x0, y0);
        ctx.lineTo(x1, y1);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
    };

    const drawHead = (u: number) => {
      const [x, y] = pos(Math.min(1, Math.max(0, u)));
      const g = ctx.createRadialGradient(x, y, 0, x, y, 28);
      g.addColorStop(0, accent);
      g.addColorStop(0.2, accent);
      g.addColorStop(1, 'transparent');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(x, y, 28, 0, Math.PI * 2);
      ctx.fill();
    };

    const frame = (time: number) => {
      ctx.clearRect(0, 0, w, h);
      const period = 7000;
      const head = ((time % period) / period) * 1.5 - 0.1; // pause offscreen between passes
      drawTrail(head, 0.55);
      drawHead(head);
      if (visible && !reduce.matches) raf = requestAnimationFrame(frame);
    };

    const still = () => {
      ctx.clearRect(0, 0, w, h);
      drawTrail(0.7, 0.7);
      drawHead(0.7);
    };

    const start = () => {
      cancelAnimationFrame(raf);
      if (reduce.matches) still();
      else raf = requestAnimationFrame(frame);
    };

    resize();
    start();
    window.addEventListener('resize', () => {
      resize();
      start();
    });
    reduce.addEventListener('change', start);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) start();
    }).observe(canvas);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(var(--grid) 1px, transparent 1px) 0 0 / 100% 4rem,
      linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0 / 4rem 100%, var(--bg);
    background-blend-mode: normal;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 40%, transparent 30%, var(--bg) 100%);
    pointer-events: none;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: var(--z-canvas);
  }
  .copy {
    position: relative;
    z-index: var(--z-content);
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
    padding: var(--space-16) var(--space-4);
  }
  h1 {
    font-size: var(--fs-display);
    max-width: 14ch;
    margin-bottom: var(--space-6);
  }
  .sub {
    font-size: var(--fs-lg);
    color: var(--fg-muted);
    max-width: var(--measure);
  }
</style>
