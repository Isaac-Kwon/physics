---
import { TOPICS, TOPIC_ORDER } from '../../data/topics';
import { topicEdges } from '../../lib/connections';
import { localizePath, useT, type Lang } from '../../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const edges = topicEdges();
const items = TOPIC_ORDER.map((id) => {
  const def = TOPICS[id];
  const conn = edges
    .filter((e) => e.a === id || e.b === id)
    .map((e) => ({ other: e.a === id ? e.b : e.a, reason: e.links[0].reason[lang] }));
  return { id, def, conn };
});
---

<ul class="list">
  {
    items.map(({ id, def, conn }) => (
      <li class:list={['row', { off: !def.released }]}>
        <div class="main">
          <h3>
            {def.released ? <a href={localizePath(lang, `/${id}/`)}>{t(`topic.${id}.title`)}</a> : <span>{t(`topic.${id}.title`)}</span>}
          </h3>
          <p class="tagline">{t(`topic.${id}.tagline`)}</p>
          {conn.length > 0 && (
            <details>
              <summary>
                {t('chrome.hub.connections')} ({conn.length})
              </summary>
              <ul>
                {conn.map((c) => (
                  <li>
                    <strong>{t(`topic.${c.other}.title`)}</strong>. {c.reason}
                  </li>
                ))}
              </ul>
            </details>
          )}
        </div>
        <p class="meta">{def.released ? t('card.readingTime', { min: def.readingMinutes }) : t('card.comingSoon')}</p>
      </li>
    ))
  }
</ul>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    gap: var(--space-1) var(--space-8);
    grid-template-columns: 1fr;
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 40rem) {
    .row {
      grid-template-columns: 1fr 9rem;
    }
    .meta {
      text-align: right;
    }
  }
  .main {
    max-width: 44rem;
  }
  h3 {
    font-size: var(--fs-lg);
    margin-bottom: var(--space-1);
  }
  h3 a {
    color: var(--fg);
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .off h3 span {
    color: var(--fg-muted);
  }
  .tagline {
    color: var(--fg-muted);
    margin: 0;
  }
  .meta {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }
  .off .meta {
    font-style: italic;
    color: var(--fg-faint);
  }
  details {
    margin-top: var(--space-3);
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }
  summary {
    cursor: pointer;
    width: fit-content;
  }
  details ul {
    margin: var(--space-2) 0 0;
    padding-left: var(--space-4);
  }
  details strong {
    color: var(--fg);
    font-weight: 600;
  }
</style>
