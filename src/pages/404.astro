---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LANGS, LANG_LABEL, localizePath, useT } from '../i18n';
const lang = 'en' as const;
const t = useT(lang);
---

<BaseLayout lang={lang} title={t('chrome.notFound.title')}>
  <div class="wrap">
    <h1>{t('chrome.notFound.title')}</h1>
    <p>{t('chrome.notFound.body')}</p>
    <ul>
      {
        LANGS.map((l) => (
          <li>
            <a href={localizePath(l, '/')} lang={l}>
              {LANG_LABEL[l]}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 46rem;
    margin: 0 auto;
    padding: var(--space-16) var(--space-4) 0;
  }
  h1 {
    font-size: var(--fs-2xl);
  }
  p {
    color: var(--fg-muted);
  }
  ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: var(--space-6);
  }
</style>
