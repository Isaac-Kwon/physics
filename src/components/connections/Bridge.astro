---
import { getLink } from '../../lib/connections';
import { TOPICS, accentCss } from '../../data/topics';
import { getLangFromUrl, localizePath, useT } from '../../i18n';

interface Props {
  id: string;
}
const lang = getLangFromUrl(Astro.url);
const t = useT(lang);
const link = getLink(Astro.props.id);
const dest = TOPICS[link.to.topic];
const title = t(`topic.${link.to.topic}.title`);
const href = link.live ? localizePath(lang, `/${link.to.topic}/#${link.to.layer}`) : undefined;
const Tag = href ? 'a' : 'div';
---

<aside class="bridge-wrap" data-bridge={link.id}>
  <Tag class:list={['bridge', { 'bridge--soon': !href }]} href={href} style={`--bridge-accent:${accentCss(link.to.topic)}`}>
    <span class="bridge__title">{t('connections.bridge.more', { topic: title })}</span>: <span class="bridge__reason">{link.reason[lang]}</span>
    {href ? <span aria-hidden="true"> →</span> : <em class="bridge__soon"> ({t('connections.bridge.soon')})</em>}
  </Tag>
</aside>

<style>
  .bridge-wrap {
    margin: var(--space-4) 0;
  }
  .bridge {
    display: block;
    padding: var(--space-2) 0 0;
    border-top: 1px solid var(--line);
    color: var(--fg-muted);
    text-decoration: none;
    font-size: var(--fs-sm);
    line-height: 1.5;
  }
  a.bridge:hover .bridge__title,
  a.bridge:focus-visible .bridge__title {
    text-decoration: underline;
  }
  a.bridge:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .bridge__title {
    color: var(--accent);
  }
  .bridge--soon .bridge__title {
    color: var(--fg-muted);
  }
  .bridge__soon {
    color: var(--fg-faint);
  }
  /* Desktop: float into the right margin of the text column without affecting flow. */
  @media (min-width: 1100px) {
    .bridge-wrap {
      float: right;
      clear: right;
      width: 15rem;
      margin: 0 calc(-15rem - var(--space-8)) var(--space-4) var(--space-6);
    }
  }
</style>
