---
/** <Deeper title> — collapsible undergraduate-level box, closed by default. */
import { getLangFromUrl, useT } from '../../i18n';
interface Props {
  title?: string;
}
const t = useT(getLangFromUrl(Astro.url));
const { title } = Astro.props;
---

<details class="deeper">
  <summary>
    <span class="deeper__title">{title ? `${t('deeper.label')}: ${title}` : t('deeper.open')}</span>
  </summary>
  <div class="deeper__body"><slot /></div>
</details>

<style is:global>
  .deeper {
    max-width: var(--measure);
    margin: var(--space-6) auto;
    border-block: 1px solid var(--line);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }
  .deeper summary {
    cursor: pointer;
    list-style: none;
    padding: var(--space-3) 0;
    font-weight: 600;
  }
  .deeper summary::-webkit-details-marker {
    display: none;
  }
  .deeper summary::before {
    content: '▸';
    display: inline-block;
    width: 1.1em;
    color: var(--fg-muted);
    font-weight: 400;
  }
  .deeper[open] summary::before {
    content: '▾';
  }
  .deeper__body {
    padding: 0 0 var(--space-3);
    overflow-x: auto;
  }
  .deeper__body > :last-child {
    margin-bottom: 0;
  }
</style>
