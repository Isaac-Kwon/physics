---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LANGS, LANG_SHORT, NUMBER_LOCALE, useT, type Lang } from '../../../i18n';
export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const entries = (await getCollection('glossary')).map((e) => e.data);
entries.sort((a, b) => a[lang].term.localeCompare(b[lang].term, NUMBER_LOCALE[lang]));
const others = LANGS.filter((l) => l !== lang);
---

<BaseLayout lang={lang} title={t('glossary.title')}>
  <div class="wrap">
    <h1>{t('glossary.title')}</h1>
    <p class="intro">{t('glossary.intro')}</p>
    {entries.length > 0 && <p class="count">{t('chrome.glossary.count', { n: entries.length })}</p>}

    {entries.length === 0 && <p class="empty">{t('chrome.glossary.empty')}</p>}

    <dl>
      {
        entries.map((e) => (
          <div class="term" id={e.id}>
            <dt>
              <a class="anchor" href={`#${e.id}`} aria-label={e[lang].term}>
                <span lang={lang}>{e[lang].term}</span>
              </a>
              {e.abbr && <span class="abbr">{e.abbr}</span>}
              {e[lang].alt && <span class="alt">({e[lang].alt})</span>}
            </dt>
            <dd>
              <p lang={lang}>{e[lang].definition}</p>
              <p class="others">
                {others.map((l) => (
                  <span lang={l}>
                    <b>{LANG_SHORT[l]}</b> {e[l].term}
                  </span>
                ))}
              </p>
              {e.topics.length > 0 && (
                <p class="related">
                  {t('glossary.relatedTopics')}: {e.topics.map((id) => t(`topic.${id}.title`)).join(', ')}
                </p>
              )}
              {!e.reviewed && <p class="draft">{t('chrome.glossary.draft')}</p>}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 46rem;
    margin: 0 auto;
    padding: var(--space-16) var(--space-4) 0;
  }
  h1 {
    font-size: var(--fs-2xl);
  }
  .intro {
    color: var(--fg-muted);
    font-size: var(--fs-lg);
    margin-bottom: var(--space-2);
  }
  .count {
    font-size: var(--fs-sm);
    color: var(--fg-faint);
  }
  .empty {
    margin-top: var(--space-12);
    color: var(--fg-muted);
    font-style: italic;
  }
  dl {
    margin: var(--space-8) 0 0;
    border-top: 1px solid var(--line);
  }
  .term {
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }
  .term:target dt {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.25em;
  }
  dt {
    font-size: var(--fs-lg);
    font-weight: 650;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
  }
  .anchor {
    color: inherit;
    text-decoration: none;
  }
  .anchor:hover {
    text-decoration: underline;
  }
  .abbr,
  .alt {
    font-size: var(--fs-sm);
    font-weight: 400;
    color: var(--fg-muted);
  }
  dd {
    margin: var(--space-2) 0 0;
    max-width: var(--measure);
  }
  .others,
  .related,
  .draft {
    font-size: var(--fs-sm);
    color: var(--fg-muted);
    margin-bottom: var(--space-2);
  }
  .others {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
  }
  .others b {
    color: var(--fg-faint);
    font-weight: 500;
    margin-right: var(--space-1);
  }
  .draft {
    color: var(--fg-faint);
    font-style: italic;
  }
</style>
