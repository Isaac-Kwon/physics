---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LANGS, LANG_LABEL, DEFAULT_LANG, localizePath, useT } from '../i18n';
const lang = 'en' as const;
const t = useT(lang);
const targets = Object.fromEntries(LANGS.map((l) => [l, localizePath(l, '/')]));
---

<BaseLayout lang={lang} bare>
  <div class="wrap">
    <p class="label">{t('site.tagline')}</p>
    <h1>{t('site.title')}</h1>
    <p class="status" data-status hidden>{t('langPicker.redirecting')}</p>
    <h2 class="label">{t('langPicker.title')}</h2>
    <ul class="picker">
      {
        LANGS.map((l) => (
          <li>
            <a href={localizePath(l, '/')} lang={l} hreflang={l} data-lang={l}>
              <span class="mono">{l.toUpperCase()}</span>
              {LANG_LABEL[l]}
            </a>
          </li>
        ))
      }
    </ul>
    <noscript><p>{t('chrome.root.noscript')}</p></noscript>
  </div>
</BaseLayout>

<script is:inline define:vars={{ targets, fallback: DEFAULT_LANG, langs: [...LANGS] }}>
  (function () {
    var KEY = 'physics.lang';
    var get = function () {
      try {
        return localStorage.getItem(KEY);
      } catch (e) {
        return null;
      }
    };
    document.querySelectorAll('[data-lang]').forEach(function (a) {
      a.addEventListener('click', function () {
        try {
          localStorage.setItem(KEY, a.getAttribute('data-lang'));
        } catch (e) {}
      });
    });
    var pick = get();
    if (langs.indexOf(pick) < 0) {
      pick = null;
      var prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
      for (var i = 0; i < prefs.length && !pick; i++) {
        var p = String(prefs[i]).toLowerCase().split('-')[0];
        if (langs.indexOf(p) >= 0) pick = p;
      }
      pick = pick || fallback;
    }
    var s = document.querySelector('[data-status]');
    if (s) s.hidden = false;
    location.replace(targets[pick]);
  })();
</script>

<style>
  .wrap {
    min-height: 100svh;
    max-width: 46rem;
    margin: 0 auto;
    padding: var(--space-24) var(--space-4);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  h1 {
    font-size: var(--fs-display);
  }
  .status {
    color: var(--fg-muted);
  }
  .picker {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    display: grid;
    gap: var(--space-3);
  }
  .picker a {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--fg);
    text-decoration: none;
    font-size: var(--fs-lg);
  }
  .picker a:hover {
    border-color: var(--accent);
  }
  .picker .mono {
    color: var(--accent);
  }
</style>
