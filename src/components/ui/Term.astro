---
import { getEntry } from 'astro:content';
import { LANGS } from '../../data/topics';
import { getLangFromUrl, LANG_SHORT } from '../../i18n';

interface Props {
  id: string;
}
const { id } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const entry = await getEntry('glossary', id);
if (!entry) console.warn(`[Term] unknown glossary id "${id}" (page ${Astro.url.pathname})`);
const d = entry?.data;
const others = d ? LANGS.filter((l) => l !== lang) : [];
const tipId = `term-${id}-${Math.random().toString(36).slice(2, 8)}`;
---

{
  !d ? (
    <slot />
  ) : (
    <span class="term" tabindex="0" role="button" aria-describedby={tipId}>
      <span class="term__text">
        <slot />
      </span>
      <span class="term__tip" role="tooltip" id={tipId}>
        <strong>{d[lang].term}</strong>
        {d.abbr && <span class="abbr"> ({d.abbr})</span>}
        <span class="def">{d[lang].definition}</span>
        <span class="others">
          {others.map((l) => (
            <span>
              <abbr title={l}>{LANG_SHORT[l]}</abbr> {d[l].term}
            </span>
          ))}
        </span>
      </span>
    </span>
  )
}

<style>
  .term {
    position: relative;
    display: inline;
    cursor: help;
  }
  .term__text {
    border-bottom: 1px dotted var(--fg-muted);
  }
  .term:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
  .term__tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 6px);
    transform: translateX(-50%);
    z-index: var(--z-tooltip);
    width: max-content;
    max-width: min(18rem, 80vw);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--fg);
    font-size: var(--fs-sm);
    line-height: 1.45;
    text-align: left;
    box-shadow: 0 2px 8px var(--shadow);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-fast);
  }
  .term:hover .term__tip,
  .term:focus .term__tip,
  .term:focus-within .term__tip {
    visibility: visible;
    opacity: 1;
  }
  .abbr {
    color: var(--fg-muted);
  }
  .def {
    display: block;
    margin-top: var(--space-1);
    color: var(--fg-muted);
  }
  .others {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-2);
    font-size: var(--fs-xs);
    color: var(--fg-faint);
  }
  .others abbr {
    text-decoration: none;
    color: var(--fg-muted);
  }
</style>
