---
/** <Step state kind> — one text step of a <Scene>/<Walkthrough>. Plain readable HTML without JS. */
import { getLangFromUrl, useT } from '../../i18n';
interface Props {
  state?: string;
  /** Walkthrough only: goal | signal | readout | trick */
  kind?: 'goal' | 'signal' | 'readout' | 'trick';
}
const { state, kind } = Astro.props;
const t = useT(getLangFromUrl(Astro.url));
---

<div class="step" data-step data-state={state} data-kind={kind}>
  <div class="step__card">
    {kind && <p class="label step__kind">{t(`scrolly.kind.${kind}`)}</p>}
    <slot />
  </div>
</div>
