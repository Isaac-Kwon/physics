---
import { getEntry, render } from 'astro:content';
import { primerUsage } from '../../lib/connections';
import { TOPICS, type Lang } from '../../data/topics';
import { getLangFromUrl, localizePath, useT } from '../../i18n';
import Scene from '../scrolly/Scene.astro';

interface Props {
  id: string;
  open?: boolean;
  lang?: Lang;
  /** MDX component map for the primer body; defaults to scrolly/mdx-components.ts when it exists. */
  components?: Record<string, any>;
}
const { id, open = false, components } = Astro.props;
const lang: Lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useT(lang);

let entry = await getEntry('primers', `${id}/${lang}` as any);
let shownLang: Lang = lang;
if (!entry && lang !== 'en') {
  entry = await getEntry('primers', `${id}/en` as any);
  shownLang = 'en';
}

// Lazily resolve the shared MDX component map (circular import: Primer is itself in that map).
let map: Record<string, any> = components ?? {};
if (entry && !components) {
  const mods = import.meta.glob('../scrolly/mdx-components.ts');
  const loader = Object.values(mods)[0];
  if (loader) {
    const m: any = await loader();
    map = m.default ?? m.mdxComponents ?? m.components ?? {};
  }
}

const Body = entry ? (await render(entry)).Content : null;
const usage = primerUsage.find((p) => p.id === id);
const origin = usage?.origin ?? null;
const originDef = origin ? TOPICS[origin.topic] : null;
const originTitle = origin ? t(`topic.${origin.topic}.title`) : '';
const uid = Math.random().toString(36).slice(2, 8);
---

{
  !entry ? (
    <aside class="primer primer--missing" data-primer={id}>
      {t('connections.primer.missing', { id })}
    </aside>
  ) : (
    <div class="aside primer" data-primer={id} lang={shownLang !== lang ? shownLang : undefined}>
      <button type="button" class="aside__open" data-modal-open aria-haspopup="dialog" aria-controls={`primer-${id}-${uid}`}>
        <span class="aside__kind">{t('primer.label')}</span>
        <span class="aside__title">{entry.data.title}</span>
        <svg class="aside__icon" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M6 3H3v10h10v-3M9 3h4v4M13 3 7.5 8.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
      <dialog class="aside__dialog" id={`primer-${id}-${uid}`} data-modal data-lenis-prevent aria-label={`${t('primer.label')}: ${entry.data.title}`}>
        <header class="aside__head">
          <p class="aside__dlg-kind">{t('primer.label')}</p>
          <h3 class="aside__dlg-title">{entry.data.title}</h3>
          <button type="button" class="aside__close" data-modal-close aria-label={t('deeper.close')}>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
          </button>
        </header>
        <div class="aside__body primer__body">
          {entry.data.figure && (
            <div class="primer__figure">
              <Scene id={entry.data.figure} label={entry.data.title} />
            </div>
          )}
          {Body && <Body components={map} />}
          {origin && originDef && (
            <p class="primer__from">
              {originDef.released ? (
                <a href={localizePath(lang, `/${origin.topic}/#${origin.layer}`)}>{t('primer.from', { topic: originTitle })}</a>
              ) : (
                <span>{t('connections.primer.fromSoon', { topic: originTitle })}</span>
              )}
            </p>
          )}
        </div>
      </dialog>
    </div>
  )
}

<script>
  import { installModals } from '../../lib/modal';
  installModals();
</script>

<style>
  /* Trigger + modal styles are the shared .aside-* rules in ui/Deeper.astro. */
  .primer__figure {
    margin-bottom: var(--space-4);
  }
  .primer__figure :global(.scene) {
    margin: 0;
  }
  .primer__from {
    margin: var(--space-4) 0 0;
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }
  .primer--missing {
    margin: var(--space-4) auto;
    max-width: var(--measure);
    font-size: var(--fs-sm);
    font-style: italic;
    color: var(--fg-faint);
  }
</style>
