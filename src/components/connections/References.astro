---
import { getLangFromUrl, useT } from '../../i18n';

interface Reference {
  title: string;
  author?: string;
  url?: string;
  note?: string;
}
interface Props {
  references?: Reference[];
}
const { references = [] } = Astro.props;
const t = useT(getLangFromUrl(Astro.url));
---

{
  references.length > 0 && (
    <section class="refs" aria-labelledby="refs-title">
      <h2 id="refs-title">{t('references.title')}</h2>
      <ul>
        {references.map((r) => (
          <li>
            {r.url ? (
              <a href={r.url} rel="noopener noreferrer" target="_blank">
                {r.title}
              </a>
            ) : (
              <span>{r.title}</span>
            )}
            {r.author && <span class="meta"> — {r.author}</span>}
            {r.note && <span class="note">{r.note}</span>}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .refs {
    max-width: var(--measure);
    margin: var(--space-12) auto var(--space-8);
    padding: 0 var(--space-4);
    font-size: var(--fs-sm);
  }
  h2 {
    font-size: var(--fs-lg);
    margin: 0 0 var(--space-3);
  }
  ul {
    margin: 0;
    padding-left: var(--space-6);
    display: grid;
    gap: var(--space-2);
  }
  a {
    color: var(--accent);
  }
  .meta {
    color: var(--fg-muted);
  }
  .note {
    display: block;
    color: var(--fg-faint);
  }
</style>
