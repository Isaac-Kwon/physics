---
/**
 * Depth Gauge: fixed vertical outline of the page (PLAN §2.4).
 *  - Layers: number + tick (tick length = tier). Click/keyboard to jump; titles on hover/focus.
 *  - Steps: under each layer, one small tick per step text box (the scroll checkpoints, src/lib/checkpoints.ts),
 *    built on the client from the page; the current step is highlighted; click a tick to go there.
 * Numbers hidden below 900px.
 */
import { getLangFromUrl, useT } from '../../i18n';
interface Props {
  layers: { id: string; title: string; tier: string }[];
}
const { layers } = Astro.props;
const t = useT(getLangFromUrl(Astro.url));
---

<nav class="gauge" aria-label={t('gauge.label')} data-gauge data-step-label={t('gauge.step')}>
  <ol class="gauge__list">
    {
      layers.map((l, i) => (
        <li class="gauge__layer">
          <a class="gauge__link" href={`#${l.id}`} data-gauge-link={l.id} style={`--tier:${Number(l.tier.slice(1)) || 0}`} aria-label={t('gauge.jump', { layer: l.title })}>
            <span class="gauge__text">
              <span class="gauge__title">{l.title}</span>
              <span class="gauge__tier">{t(`tier.${l.tier}`)}</span>
            </span>
            <span class="gauge__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="gauge__tick" aria-hidden="true" />
          </a>
          <ol class="gauge__steps" data-gauge-steps={l.id} />
        </li>
      ))
    }
  </ol>
</nav>

<script>
  import { list, go, currentIndex } from '../../lib/checkpoints';

  const gauge = document.querySelector<HTMLElement>('[data-gauge]');
  if (gauge) {
    const links = [...gauge.querySelectorAll<HTMLAnchorElement>('[data-gauge-link]')];
    const byId = new Map(links.map((a) => [a.dataset.gaugeLink!, a]));
    const stepLabel = gauge.dataset.stepLabel ?? 'Step';

    // ---- layer highlight (fallback when no step box is near the centre) ----
    const setLayer = (id: string) => {
      links.forEach((a) => {
        if (a.dataset.gaugeLink === id) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    };
    const sections = [...document.querySelectorAll<HTMLElement>('section[data-layer]')].filter((s) => byId.has(s.id));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting && currentIndex() < 0) setLayer(e.target.id);
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
    if (sections[0]) setLayer(sections[0].id);

    // ---- step ticks, one per checkpoint, grouped under their layer ----
    const cards = list();
    const subs: HTMLButtonElement[] = [];
    const layerOf: string[] = [];
    cards.forEach((card, i) => {
      const layer = card.closest<HTMLElement>('section[data-layer]')?.id ?? '';
      const ol = gauge.querySelector<HTMLOListElement>(`[data-gauge-steps="${layer}"]`);
      layerOf[i] = layer;
      if (!ol) return;
      const n = ol.children.length + 1;
      const text = (card.textContent ?? '').replace(/\s+/g, ' ').trim();
      const li = document.createElement('li');
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'gauge__sub';
      b.setAttribute('aria-label', `${stepLabel} ${n}: ${text.slice(0, 80)}${text.length > 80 ? '…' : ''}`);
      b.title = text.length > 90 ? `${text.slice(0, 90)}…` : text;
      b.addEventListener('click', () => go(i));
      li.append(b);
      ol.append(li);
      subs[i] = b;
    });

    document.addEventListener('checkpoint:change', (e) => {
      const i = (e as CustomEvent<{ index: number }>).detail.index;
      subs.forEach((b, j) => (j === i ? b.setAttribute('aria-current', 'step') : b?.removeAttribute('aria-current')));
      if (i >= 0 && layerOf[i]) setLayer(layerOf[i]);
    });

    // ---- keyboard: arrow keys move focus between layer links ----
    gauge.addEventListener('keydown', (e) => {
      const i = links.indexOf(document.activeElement as HTMLAnchorElement);
      if (i < 0) return;
      const n = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? i - 1 : null;
      if (n === null) return;
      e.preventDefault();
      links[(n + links.length) % links.length].focus();
    });
  }
</script>

<style>
  .gauge {
    position: fixed;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    z-index: var(--z-gauge);
    padding: var(--space-2) var(--space-2) var(--space-2) 0;
    max-height: calc(100vh - var(--header-h) - 2rem);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .gauge__list {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    overflow-y: auto;
    scrollbar-width: none;
  }
  .gauge__list::before {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }
  .gauge__link {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-2);
    height: 1.5rem;
    text-decoration: none;
    color: var(--fg-faint);
    position: relative;
  }
  .gauge__num {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
  }
  /* Tick length encodes the tier (T0 short .. T4 long). */
  .gauge__tick {
    width: calc(0.4rem + var(--tier) * 0.15rem);
    height: 1px;
    background: var(--fg-faint);
    flex: none;
  }
  .gauge__text {
    display: none;
    position: absolute;
    right: calc(100% + var(--space-2));
    top: 50%;
    translate: 0 -50%;
    width: max-content;
    max-width: 14rem;
    text-align: right;
    font-size: var(--fs-sm);
    line-height: 1.25;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
    box-shadow: 0 2px 8px var(--shadow);
  }
  .gauge__tier {
    display: block;
    font-size: var(--fs-xs);
    color: var(--fg-muted);
  }
  .gauge__link:hover,
  .gauge__link:focus-visible {
    color: var(--fg);
  }
  .gauge__link:hover .gauge__text,
  .gauge__link:focus-visible .gauge__text {
    display: block;
  }
  .gauge__link[aria-current] {
    color: var(--accent);
  }
  .gauge__link[aria-current] .gauge__tick {
    background: var(--accent);
    height: 2px;
  }

  /* Step ticks: short marks hanging off the rule, one per step box. */
  .gauge__steps {
    list-style: none;
    margin: 0 0 0.25rem;
    padding: 0;
  }
  .gauge__steps:empty {
    display: none;
  }
  .gauge__steps :global(.gauge__sub) {
    display: block;
    margin-left: auto;
    width: 0.9rem;
    height: 0.45rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    position: relative;
  }
  .gauge__steps :global(.gauge__sub)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 0.3rem;
    height: 1px;
    background: var(--fg-faint);
    opacity: 0.7;
  }
  .gauge__steps :global(.gauge__sub:hover)::after,
  .gauge__steps :global(.gauge__sub:focus-visible)::after {
    width: 0.6rem;
    opacity: 1;
    background: var(--fg);
  }
  .gauge__steps :global(.gauge__sub[aria-current])::after {
    width: 0.6rem;
    height: 2px;
    opacity: 1;
    background: var(--accent);
  }

  @media (max-width: 899px) {
    .gauge {
      padding-right: 0;
    }
    .gauge__num {
      display: none;
    }
    .gauge__link {
      height: 1.2rem;
    }
    .gauge__steps :global(.gauge__sub) {
      height: 0.35rem;
    }
  }
</style>
