---
import { LANGS, LANG_LABEL, LANG_SHORT, localizePath, stripLang, useT, type Lang } from '../../i18n';
import { TOPICS, TOPIC_ORDER, type TopicId } from '../../data/topics';
interface Props {
  lang: Lang;
  topic?: TopicId;
}
const { lang, topic } = Astro.props;
const t = useT(lang);
const path = stripLang(Astro.url);
---

<header class="site-header">
  <div class="bar">
    <a class="logo" href={localizePath(lang, '/')} aria-label={t('chrome.logoLabel', { title: t('site.title') })}>
      <span class="name">{t('site.title')}</span>
    </a>

    <nav class="nav" aria-label={t('nav.menu')}>
      <details class="topics">
        <summary>{t('chrome.topicsMenu')}</summary>
        <ul>
          {
            TOPIC_ORDER.map((id) => {
              const def = TOPICS[id];
              return (
                <li>
                  {def.released ? (
                    <a href={localizePath(lang, `/${id}/`)} aria-current={id === topic ? 'page' : undefined}>
                      {t(`topic.${id}.title`)}
                    </a>
                  ) : (
                    <span class="off" aria-disabled="true">
                      {t(`topic.${id}.title`)}
                      <small>{t('chrome.comingSoonShort')}</small>
                    </span>
                  )}
                </li>
              );
            })
          }
          <li class="sep"><a class="plain" href={localizePath(lang, '/glossary/')}>{t('nav.glossary')}</a></li>
          <li><a class="plain" href={localizePath(lang, '/about/')}>{t('nav.about')}</a></li>
        </ul>
      </details>

      <ul class="langs" aria-label={t('nav.language')}>
        {
          LANGS.map((l) => (
            <li>
              <a
                href={localizePath(l, path)}
                lang={l}
                hreflang={l}
                title={LANG_LABEL[l]}
                aria-current={l === lang ? 'true' : undefined}
              >
                {LANG_SHORT[l]}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-pressed="false"
        aria-label={t('theme.toggle')}
        title={t('theme.toggle')}
        data-label-light={t('theme.light')}
        data-label-dark={t('theme.dark')}
      >
        <svg class="icon icon--moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
        </svg>
        <svg class="icon icon--sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  // Light (default) ↔ dark. The saved choice is applied before first paint by BaseLayout's inline script.
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (toggle) {
    const root = document.documentElement;
    const sync = () => {
      const dark = root.dataset.theme === 'dark';
      toggle.setAttribute('aria-pressed', String(dark));
      toggle.title = (dark ? toggle.dataset.labelLight : toggle.dataset.labelDark) ?? '';
      document.querySelector('[data-theme-color]')?.setAttribute('content', dark ? '#05060a' : '#ffffff');
    };
    sync();
    toggle.addEventListener('click', () => {
      const dark = root.dataset.theme !== 'dark';
      if (dark) root.dataset.theme = 'dark';
      else delete root.dataset.theme;
      try {
        localStorage.setItem('physics.theme', dark ? 'dark' : 'light');
      } catch {
        /* storage unavailable: choice lasts for this page only */
      }
      sync();
    });
  }

  // Enhancement: close the topic menu on outside click / Escape.
  const d = document.querySelector<HTMLDetailsElement>('.site-header details.topics');
  if (d) {
    document.addEventListener('click', (e) => {
      if (d.open && !d.contains(e.target as Node)) d.open = false;
    });
    d.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && d.open) {
        d.open = false;
        d.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .theme-toggle:hover {
    color: var(--fg);
  }
  .theme-toggle .icon {
    grid-area: 1 / 1;
  }
  /* Show the icon of the theme you would switch TO. */
  .theme-toggle .icon--sun,
  :global(html[data-theme='dark']) .theme-toggle .icon--moon {
    display: none;
  }
  :global(html[data-theme='dark']) .theme-toggle .icon--sun {
    display: block;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    height: var(--header-h);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    height: 100%;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .logo {
    color: var(--fg);
    text-decoration: none;
    font-weight: 650;
    min-width: 0;
  }
  .name {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: var(--fs-sm);
  }
  @media (min-width: 40rem) {
    .name {
      font-size: var(--fs-base);
    }
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex: none;
  }
  .topics {
    position: relative;
  }
  summary {
    list-style: none;
    cursor: pointer;
    font-size: var(--fs-sm);
    color: var(--fg-muted);
    padding: var(--space-2) 0;
    user-select: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '';
    display: inline-block;
    margin-left: 0.4em;
    width: 0.4em;
    height: 0.4em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.15em) rotate(45deg);
  }
  summary:hover,
  details[open] > summary {
    color: var(--fg);
  }
  .topics ul {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
    width: min(18rem, calc(100vw - 2rem));
    margin: 0;
    padding: var(--space-2) 0;
    list-style: none;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .topics li a,
  .topics li .off {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    color: var(--fg);
    text-decoration: none;
    font-size: var(--fs-sm);
  }
  .topics li a:hover,
  .topics li a[aria-current='page'] {
    background: var(--bg-raised);
  }
  .off {
    color: var(--fg-faint) !important;
    cursor: default;
  }
  .off small {
    margin-left: auto;
    font-style: italic;
    font-size: var(--fs-sm);
  }
  .sep {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
  }
  .plain {
    color: var(--fg-muted) !important;
  }
  .langs {
    display: flex;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-sm);
  }
  .langs a {
    display: block;
    padding: var(--space-2) 0;
    color: var(--fg-muted);
    text-decoration: none;
  }
  .langs a:hover {
    color: var(--fg);
  }
  .langs a[aria-current] {
    color: var(--fg);
    font-weight: 600;
  }
</style>
