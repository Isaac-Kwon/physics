---
import { localizePath, useT, type Lang } from '../../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<footer class="site-footer">
  <div class="inner">
    <nav aria-label={t('nav.menu')}>
      <a href={localizePath(lang, '/')}>{t('nav.home')}</a>
      <a href={localizePath(lang, '/glossary/')}>{t('nav.glossary')}</a>
      <a href={localizePath(lang, '/about/')}>{t('nav.about')}</a>
    </nav>
    <p>{t('footer.license')}</p>
    <p>{t('chrome.footer.draftNote')}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-24);
    border-top: 1px solid var(--line);
    position: relative;
    z-index: var(--z-content);
  }
  .inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-8);
    font-size: var(--fs-sm);
    color: var(--fg-faint);
  }
  nav {
    display: flex;
    gap: var(--space-6);
    margin-bottom: var(--space-3);
  }
  a {
    color: var(--fg-muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--fg);
    text-decoration: underline;
  }
  p {
    margin: 0;
    max-width: var(--measure);
  }
</style>
