---
import { getLink } from '../../lib/connections';
import { TOPICS, accentCss } from '../../data/topics';
import { getLangFromUrl, localizePath, useT } from '../../i18n';

interface Props {
  id: string;
}
const lang = getLangFromUrl(Astro.url);
const t = useT(lang);
const link = getLink(Astro.props.id);
const dest = TOPICS[link.to.topic];
const title = t(`topic.${link.to.topic}.title`);
const href = link.live ? localizePath(lang, `/${link.to.topic}/#${link.to.layer}`) : undefined;
const Tag = href ? 'a' : 'div';
---

<aside class="bridge-wrap" data-bridge={link.id}>
  <Tag class:list={['bridge', { 'bridge--soon': !href }]} href={href} style={`--bridge-accent:${accentCss(link.to.topic)}`}>
    <span class="bridge__label">{href ? t('bridge.label') : t('connections.bridge.soon')}</span>
    <span class="bridge__title">{title}</span>
    <span class="bridge__reason">{link.reason[lang]}</span>
  </Tag>
</aside>

<style>
  .bridge-wrap {
    margin: var(--space-4) 0;
  }
  .bridge {
    display: block;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line);
    border-left: 3px solid var(--bridge-accent);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--fg);
    text-decoration: none;
    font-size: var(--fs-sm);
    line-height: 1.45;
    transition:
      border-color var(--dur-fast),
      background var(--dur-fast);
  }
  a.bridge:hover,
  a.bridge:focus-visible {
    border-color: var(--bridge-accent);
    background: color-mix(in oklab, var(--bridge-accent) 8%, var(--bg-raised));
  }
  a.bridge:focus-visible {
    outline: 2px solid var(--bridge-accent);
    outline-offset: 2px;
  }
  .bridge--soon {
    border-style: dashed;
    opacity: 0.75;
  }
  .bridge__label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--bridge-accent);
  }
  .bridge__title {
    display: block;
    font-weight: 600;
    margin: 2px 0;
  }
  .bridge__reason {
    display: block;
    color: var(--fg-muted);
  }
  /* Desktop: float into the right margin of the text column without affecting flow. */
  @media (min-width: 1100px) {
    .bridge-wrap {
      float: right;
      clear: right;
      width: 15rem;
      margin: 0 calc(-15rem - var(--space-8)) var(--space-4) var(--space-6);
    }
  }
</style>
